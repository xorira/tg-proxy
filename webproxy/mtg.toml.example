secret = "<WEBPROXY_SECRET>"
bind-to = "127.0.0.1:3128"
prefer-ip = "prefer-ipv4"
auto-update = false
concurrency = 4096

[network]
proxies = ["socks5://v2ray:1080"]
dns = "127.0.0.11"

[network.timeout]
tcp = "10s"
idle = "5m"

[defense.blocklist]
enabled = false

[defense.allowlist]
enabled = false
