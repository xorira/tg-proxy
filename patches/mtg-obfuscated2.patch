 	data [hfLen]byte
@@ -53,6 +64,20 @@ func (h *handshakeFrame) connectionType() []byte {
 	return h.data[hfOffsetConnectionType : hfOffsetConnectionType+hfLenConnectionType]
 }
 
+// connectionTypeSupported reports whether the frame carries one of the stock
+// MTProto transport markers.
+func (h *handshakeFrame) connectionTypeSupported() bool {
+	val := h.connectionType()
+
+	for _, candidate := range hfConnectionTypeSet {
+		if subtle.ConstantTimeCompare(val, candidate[:]) == 1 {
+			return true
+		}
+	}
+
+	return false
+}
+
 func (h *handshakeFrame) dcSlice() []byte {
 	return h.data[hfOffsetDC : hfOffsetDC+2]
 }
