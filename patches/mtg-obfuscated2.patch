+// Connection-Type markers of the three stock MTProto transports. Stock MTProxy
+// accepts all of them, and mtg relays the inner stream opaquely, so restricting
+// the set to one marker only rejects valid clients. The faketls path uses
+// padded intermediate, the plain obfuscated2 path may use any of the three.
+var (
+	hfConnectionType     = [hfLenConnectionType]byte{0xdd, 0xdd, 0xdd, 0xdd}
+	hfConnectionTypeSet  = [][hfLenConnectionType]byte{
+		{0xef, 0xef, 0xef, 0xef}, // abridged
+		{0xee, 0xee, 0xee, 0xee}, // intermediate
+		{0xdd, 0xdd, 0xdd, 0xdd}, // padded intermediate
+	}
+)
 
